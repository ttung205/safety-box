generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Device {
  id           Int       @id @default(autoincrement())
  name         String
  apiKeyHash   String    @unique @map("api_key_hash")
  state        String?
  ip           String?
  rssi         Int?
  fw           String?
  timeOk       Boolean?  @map("time_ok")
  uptime       Int?
  freeHeap     Int?      @map("free_heap")
  lastSeenAt   DateTime? @map("last_seen_at")
  // Tăng 1 mỗi lần thêm/xóa thẻ; ESP32 chỉ tải lại danh sách khi số này đổi.
  cardsVersion Int       @default(1) @map("cards_version")
  createdAt    DateTime  @default(now()) @map("created_at")

  events SafeEvent[]
  cards  Card[]

  @@map("devices")
}

model SafeEvent {
  id         Int      @id @default(autoincrement())
  deviceId   Int      @map("device_id")
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  // "<boot_id>-<seq>": ESP32 gửi lại lô cũ cũng không bị ghi trùng
  uid        String
  type       String
  severity   String // critical | warning | info
  state      String?
  message    String
  meta       Json?
  occurredAt DateTime @map("occurred_at")
  receivedAt DateTime @default(now()) @map("received_at")

  @@unique([deviceId, uid])
  @@index([type])
  @@index([severity])
  @@index([occurredAt])
  @@map("safe_events")
}

model Card {
  id        Int      @id @default(autoincrement())
  deviceId  Int      @map("device_id")
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  uid       String // "DE AD BE EF", chữ in hoa
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([deviceId, uid])
  @@map("cards")
}

// Đăng ký nhận Web Push của từng thiết bị (điện thoại/trình duyệt) của người dùng Supabase.
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("push_subscriptions")
}
