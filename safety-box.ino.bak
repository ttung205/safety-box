void tamperArm(bool armed);

// Bỏ qua cảm biến trong `ms` mili giây (bấm phím, servo quay...).
void tamperMute(uint32_t ms);

// Gọi liên tục trong loop(). Khi một cửa sổ kết thúc: ghi số liệu vào *closed,
// trả về true nếu vượt ngưỡng (và đang bật giám sát).
// *closed = {0,0} nếu cửa sổ chưa kết thúc.
bool tamperPoll(TamperWindow* closed);

// Số liệu của cửa sổ đang chạy (cho màn hình hiệu chỉnh / plotter).
TamperWindow tamperLive();
// Số liệu của cửa sổ gần nhất đã kết thúc.
TamperWindow tamperLast();

