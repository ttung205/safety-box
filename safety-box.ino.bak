// ============================================================================
//  5. TOTP – SHA1 / HMAC / HOTP (đã test với vector RFC 6238)
// ============================================================================

// ---------------------------------------------------------------- SHA-1 ----

struct Sha1 {
  uint32_t h[5];
  uint8_t buf[64];
  uint64_t len = 0;   // tổng số byte đã nạp
  size_t bufLen = 0;

  Sha1() {
    h[0] = 0x67452301; h[1] = 0xEFCDAB89; h[2] = 0x98BADCFE;
    h[3] = 0x10325476; h[4] = 0xC3D2E1F0;
  }

  static uint32_t rol(uint32_t x, int n) { return (x << n) | (x >> (32 - n)); }

  void block(const uint8_t* p) {
    uint32_t w[80];
    for (int i = 0; i < 16; i++)
      w[i] = (uint32_t)p[4 * i] << 24 | (uint32_t)p[4 * i + 1] << 16 |
             (uint32_t)p[4 * i + 2] << 8 | p[4 * i + 3];
    for (int i = 16; i < 80; i++)
      w[i] = rol(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1);
    uint32_t a = h[0], b = h[1], c = h[2], d = h[3], e = h[4];
    for (int i = 0; i < 80; i++) {
      uint32_t f, k;
      if (i < 20)      { f = (b & c) | (~b & d);           k = 0x5A827999; }
      else if (i < 40) { f = b ^ c ^ d;                    k = 0x6ED9EBA1; }
      else if (i < 60) { f = (b & c) | (b & d) | (c & d);  k = 0x8F1BBCDC; }
      else             { f = b ^ c ^ d;                    k = 0xCA62C1D6; }
      uint32_t t = rol(a, 5) + f + e + k + w[i];
      e = d; d = c; c = rol(b, 30); b = a; a = t;
    }
    h[0] += a; h[1] += b; h[2] += c; h[3] += d; h[4] += e;
  }

  void update(const uint8_t* p, size_t n) {
    len += n;
    while (n > 0) {
      size_t take = 64 - bufLen;
      if (take > n) take = n;
      memcpy(buf + bufLen, p, take);
      bufLen += take; p += take; n -= take;
      if (bufLen == 64) { block(buf); bufLen = 0; }
    }
  }

  void final(uint8_t out[20]) {
    uint64_t bits = len * 8;
    uint8_t pad = 0x80;
    update(&pad, 1);
    uint8_t zero = 0;
    while (bufLen != 56) update(&zero, 1);
    uint8_t lenBytes[8];
    for (int i = 0; i < 8; i++) lenBytes[i] = (uint8_t)(bits >> (56 - 8 * i));
    update(lenBytes, 8);
    for (int i = 0; i < 5; i++) {
      out[4 * i] = h[i] >> 24; out[4 * i + 1] = h[i] >> 16;
      out[4 * i + 2] = h[i] >> 8; out[4 * i + 3] = h[i];
    }
  }
};


// ------------------------------------------------------------- HMAC-SHA1 ----
void hmacSha1(const uint8_t* key, size_t keyLen, const uint8_t* msg,
              size_t msgLen, uint8_t out[20]) {
  uint8_t k[64] = {0};
  if (keyLen > 64) {
    Sha1 s; s.update(key, keyLen); s.final(k);
  } else {
    memcpy(k, key, keyLen);
  }
  uint8_t ipad[64], opad[64];
  for (int i = 0; i < 64; i++) { ipad[i] = k[i] ^ 0x36; opad[i] = k[i] ^ 0x5C; }

  uint8_t inner[20];
  Sha1 si; si.update(ipad, 64); si.update(msg, msgLen); si.final(inner);
  Sha1 so; so.update(opad, 64); so.update(inner, 20); so.final(out);
}

// ------------------------------------------------------------------ HOTP ----
uint32_t hotp(const uint8_t* key, size_t keyLen, uint64_t counter, int digits) {
  uint8_t msg[8];
  for (int i = 7; i >= 0; i--) { msg[i] = counter & 0xFF; counter >>= 8; }
  uint8_t mac[20];
  hmacSha1(key, keyLen, msg, 8, mac);
  int off = mac[19] & 0x0F;
  uint32_t bin = ((uint32_t)(mac[off] & 0x7F) << 24) |
                 ((uint32_t)mac[off + 1] << 16) |
                 ((uint32_t)mac[off + 2] << 8) | mac[off + 3];
  uint32_t mod = 1;
  for (int i = 0; i < digits; i++) mod *= 10;
  return bin % mod;
}

// ---------------------------------------------------------------- Base32 ----
int base32Decode(const char* in, uint8_t* out, size_t outMax) {
  uint32_t buffer = 0;
  int bits = 0;
  size_t n = 0;
  for (const char* p = in; *p; p++) {
    char c = *p;
    int v;
    if (c >= 'A' && c <= 'Z') v = c - 'A';
    else if (c >= 'a' && c <= 'z') v = c - 'a';
    else if (c >= '2' && c <= '7') v = c - '2' + 26;
    else if (c == ' ' || c == '-' || c == '=') continue;
    else return -1;
    buffer = (buffer << 5) | v;
    bits += 5;
    if (bits >= 8) {
      if (n >= outMax) return -1;
      out[n++] = (uint8_t)(buffer >> (bits - 8));
      bits -= 8;
    }
  }
  return (int)n;
}

// -------------------------------------------------------- TotpVerifier ----
bool TotpVerifier::verify(const char* code, uint64_t unixUtc) {
  // Chỉ chấp nhận đúng `digits_` chữ số.
  size_t len = strlen(code);
  if ((int)len != digits_) return false;
  uint32_t value = 0;
  for (size_t i = 0; i < len; i++) {
    if (code[i] < '0' || code[i] > '9') return false;
    value = value * 10 + (code[i] - '0');
  }

  int64_t step = (int64_t)(unixUtc / period_);
  for (int d = -window_; d <= window_; d++) {
    int64_t s = step + d;
    if (s < 0 || s <= lastUsedStep_) continue;  // mã cũ hoặc đã dùng
    if (hotp(key_, keyLen_, (uint64_t)s, digits_) == value) {
      lastUsedStep_ = s;
      return true;
    }
  }
  return false;
}

// ============================================================================
//  6. CẢM BIẾN RUNG SW-420
// ============================================================================
static TamperConfig s_cfg;
static portMUX_TYPE s_mux = portMUX_INITIALIZER_UNLOCKED;

// Biến dùng chung với ISR (chỉ đọc/ghi trong vùng găng)
static volatile uint16_t s_hits = 0;
static volatile uint32_t s_vibUs = 0;       // thời gian rung đã cộng dồn
static volatile uint32_t s_riseUs = 0;      // thời điểm bắt đầu rung hiện tại
static volatile bool s_active = false;      // DO đang ở mức "rung"
static volatile uint32_t s_lastEdgeUs = 0;

static uint32_t s_windowStart = 0;
static uint32_t s_muteUntil = 0;
static bool s_armed = true;
static TamperWindow s_last = {0, 0};

static void IRAM_ATTR onEdge() {
  uint32_t now = micros();
  bool level = gpio_get_level((gpio_num_t)s_cfg.pin);
  bool active = s_cfg.activeHigh ? level : !level;

  portENTER_CRITICAL_ISR(&s_mux);
  if (active && !s_active) {
    // Bắt đầu rung. Chỉ tính là va đập mới nếu đã yên lặng đủ lâu.
    if (now - s_lastEdgeUs > (uint32_t)s_cfg.hitGapMs * 1000) s_hits++;
    s_riseUs = now;
    s_active = true;
  } else if (!active && s_active) {
    s_vibUs += now - s_riseUs;
    s_active = false;
  }
  s_lastEdgeUs = now;
  portEXIT_CRITICAL_ISR(&s_mux);
}

// Lấy số liệu và (tuỳ chọn) xóa bộ đếm. Phần đang rung dở được tính đến hiện tại.
static TamperWindow snapshot(bool reset) {
  uint32_t now = micros();
  TamperWindow w;
  portENTER_CRITICAL(&s_mux);
  uint32_t vib = s_vibUs + (s_active ? now - s_riseUs : 0);
  w.hits = s_hits;
  w.vibMs = vib / 1000;
  if (reset) {
    s_hits = 0;
    s_vibUs = 0;
    if (s_active) s_riseUs = now;
  }
  portEXIT_CRITICAL(&s_mux);
  return w;
}

void tamperBegin(const TamperConfig& cfg) {
  s_cfg = cfg;
  pinMode(cfg.pin, INPUT);   // GPIO34 không có điện trở kéo nội – module SW-420 đã có sẵn
  attachInterrupt(digitalPinToInterrupt(cfg.pin), onEdge, CHANGE);
  s_windowStart = millis();
}

void tamperArm(bool armed) {
  if (armed && !s_armed) { snapshot(true); s_windowStart = millis(); }
  s_armed = armed;
}

void tamperMute(uint32_t ms) {
  uint32_t until = millis() + ms;
  if ((int32_t)(until - s_muteUntil) > 0) s_muteUntil = until;
  snapshot(true);
}

TamperWindow tamperLive() { return snapshot(false); }
TamperWindow tamperLast() { return s_last; }

bool tamperPoll(TamperWindow* closed) {
  uint32_t now = millis();
  if (closed) *closed = {0, 0};

  if ((int32_t)(now - s_muteUntil) < 0) {     // đang tạm bỏ qua
    snapshot(true);
    s_windowStart = now;
    return false;
  }
  if (now - s_windowStart < s_cfg.windowMs) return false;

  TamperWindow w = snapshot(true);
  s_windowStart = now;
  s_last = w;
  if (closed) *closed = w;
  return s_armed && (w.hits >= s_cfg.hitThreshold || w.vibMs >= s_cfg.vibMsThreshold);
}

// ============================================================================
//  7. GHI LOG + GỬI SỰ KIỆN LÊN SERVER (task riêng ở core 0)
// ============================================================================
static bool isHttps() { return strncmp(API_BASE, "https", 5) == 0; }

static int postJson(const char* path, const String& body) {
  String url = String(API_BASE) + path;
  HTTPClient http;
  WiFiClient plain;
  WiFiClientSecure secure;
  bool ok;
  if (isHttps()) {
    // Demo: bỏ qua kiểm tra chứng chỉ. Triển khai thật: secure.setCACert(ROOT_CA).
    secure.setInsecure();
    ok = http.begin(secure, url);
  } else {
    ok = http.begin(plain, url);
  }
  if (!ok) return -1;
  http.setTimeout(5000);
  http.addHeader("Content-Type", "application/json");
  http.addHeader("Accept", "application/json");
  http.addHeader("X-Device-Key", DEVICE_KEY);
  int code = http.POST(body);
  http.end();
  return code;
}

static bool sendBatch(SafeEvent* ev, int n) {
  JsonDocument doc;
  doc["boot_id"] = s_bootId;
  JsonArray arr = doc["events"].to<JsonArray>();
  for (int i = 0; i < n; i++) {
    JsonObject o = arr.add<JsonObject>();
    o["seq"] = ev[i].seq;
    o["ts"] = ev[i].ts;
    o["type"] = ev[i].type;
    o["state"] = ev[i].state;
    o["message"] = ev[i].message;
    if (ev[i].meta[0]) o["meta"] = serialized(ev[i].meta);
  }
  String body;
  serializeJson(doc, body);
  int code = postJson("/events", body);
  if (code < 200 || code >= 300)
    Serial.printf("[NET] Gui su kien that bai (HTTP %d), se thu lai\n", code);
  // 422 = dữ liệu sai -> bỏ batch để không kẹt mãi
  return (code >= 200 && code < 300) || code == 422;
}

static void sendHeartbeat() {
  JsonDocument doc;
  doc["state"] = (const char*)s_state;
  doc["rssi"] = WiFi.RSSI();
  doc["ip"] = WiFi.localIP().toString();
  doc["uptime"] = (uint32_t)(millis() / 1000);
  doc["time_ok"] = timeIsValid();
  doc["fw"] = FW_VERSION;
  doc["free_heap"] = ESP.getFreeHeap();
  String body;
  serializeJson(doc, body);
  int code = postJson("/heartbeat", body);
  if (code == 401) Serial.println(F("[NET] Sai DEVICE_KEY (HTTP 401)"));
}

static int getJson(const char* path, String& out) {
  String url = String(API_BASE) + path;
  HTTPClient http;
  WiFiClient plain;
  WiFiClientSecure secure;
  bool ok;
  if (isHttps()) {
    secure.setInsecure();
    ok = http.begin(secure, url);
  } else {
    ok = http.begin(plain, url);
  }
  if (!ok) return -1;
  http.setTimeout(5000);
  http.addHeader("Accept", "application/json");
  http.addHeader("X-Device-Key", DEVICE_KEY);
  int code = http.GET();
  if (code == 200) out = http.getString();
  http.end();
  return code;
}

// ---- Danh sách thẻ Admin ----
// csv: "DE AD BE EF,04 A1 B2 C3"
static void setCardsFromCsv(const char* csv, uint32_t version) {
  static char tmp[MAX_CARDS][32];
  int n = 0;
  const char* p = csv;
  while (*p && n < MAX_CARDS) {
    const char* e = strchr(p, ',');
    size_t len = e ? (size_t)(e - p) : strlen(p);
    if (len > 0 && len < sizeof tmp[0]) {
      memcpy(tmp[n], p, len);
      tmp[n][len] = '\0';
      n++;
    }
    if (!e) break;
    p = e + 1;
  }
  portENTER_CRITICAL(&g_cardsMux);
  memcpy(g_cards, tmp, sizeof tmp[0] * n);
  g_cardCount = n;
  g_cardsVersion = version;
  portEXIT_CRITICAL(&g_cardsMux);
}

// Gọi trong setup(): lấy danh sách đã lưu, chưa có thì dùng BOOTSTRAP_ADMIN_UIDS.
void cardsBegin() {
  Preferences p;
  bool hasSaved = p.begin("cards", true) && p.isKey("list");
  if (hasSaved) {
    String csv = p.getString("list", "");
    setCardsFromCsv(csv.c_str(), p.getUInt("ver", 0));
    Serial.printf("[CARDS] Dung %d the da luu tu server (v%u)\n", g_cardCount, g_cardsVersion);
  } else {
    String csv;
    for (const char* uid : BOOTSTRAP_ADMIN_UIDS) {
      if (csv.length()) csv += ',';
      csv += uid;
    }
    setCardsFromCsv(csv.c_str(), 0);
    Serial.printf("[CARDS] Chua dong bo voi server - dung %d the BOOTSTRAP\n", g_cardCount);
  }
  p.end();
}

bool isAdminCard(const char* uid) {
  bool found = false;
  portENTER_CRITICAL(&g_cardsMux);
  for (int i = 0; i < g_cardCount && !found; i++)
    if (strcasecmp(g_cards[i], uid) == 0) found = true;
  portEXIT_CRITICAL(&g_cardsMux);
  return found;
}

void printCards() {
  Serial.printf("[CARDS] Phien ban %u, %d the:\n", g_cardsVersion, g_cardCount);
  for (int i = 0; i < g_cardCount; i++) Serial.printf("  - %s\n", g_cards[i]);
}

// Server trả về: {"version": 3, "cards": ["DE AD BE EF", ...]}
// (hoặc "cards": [{"uid": "DE AD BE EF", "name": "..."}]). version tăng mỗi lần sửa.
static void syncCards() {
  String body;
  int code = getJson("/cards", body);
  if (code == 404) return;   // backend chưa làm chức năng quản lý thẻ
  if (code != 200) {
    Serial.printf("[CARDS] Khong tai duoc danh sach the (HTTP %d)\n", code);
    return;
  }
  JsonDocument doc;
  if (deserializeJson(doc, body.c_str())) {
    Serial.println(F("[CARDS] Du lieu tra ve khong phai JSON hop le"));
    return;
  }
  uint32_t ver = doc["version"] | 0;
  if (ver == 0 || ver == g_cardsVersion) return;   // không có gì mới

  String csv;
  for (JsonVariant c : doc["cards"].as<JsonArray>()) {
    const char* uid = c.is<const char*>() ? c.as<const char*>() : (c["uid"] | "");
    if (!uid[0] || strchr(uid, ',')) continue;
    if (csv.length()) csv += ',';
    csv += uid;
  }
  setCardsFromCsv(csv.c_str(), ver);
  Preferences p;
  if (p.begin("cards", false)) {
    p.putString("list", csv);
    p.putUInt("ver", ver);
    p.end();
  }
  Serial.printf("[CARDS] Da cap nhat %d the tu server (v%u)\n", g_cardCount, ver);
}

static void netTask(void*) {
  SafeEvent pending[BATCH];
  int pendingN = 0;
  uint32_t lastHeartbeat = 0, nextTry = 0, backoff = 0, lastWifiTry = 0;
  bool cardsDue = true;
  uint32_t lastCardSync = 0;
  bool wasConnected = false;

  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(true);
  WiFi.begin(WIFI_SSID, WIFI_PASS);

  for (;;) {
    bool connected = WiFi.status() == WL_CONNECTED;
    if (connected && !wasConnected) {
      Serial.printf("[NET] Da ket noi WiFi, IP %s\n", WiFi.localIP().toString().c_str());
      lastHeartbeat = 0;  // gửi heartbeat ngay
      cardsDue = true;    // và tải danh sách thẻ ngay
    }
    if (!connected && millis() - lastWifiTry > 15000) {
      lastWifiTry = millis();
      WiFi.reconnect();
    }
    wasConnected = connected;

    if (connected) {
      while (pendingN < BATCH && xQueueReceive(s_queue, &pending[pendingN], 0) == pdTRUE)
        pendingN++;
      if (pendingN > 0 && (int32_t)(millis() - nextTry) >= 0) {
        if (sendBatch(pending, pendingN)) {
          pendingN = 0;
          backoff = 0;
        } else {
          backoff = backoff ? min<uint32_t>(backoff * 2, 60000) : 2000;
          nextTry = millis() + backoff;
        }
      }
      if (lastHeartbeat == 0 || millis() - lastHeartbeat > HEARTBEAT_MS) {
        sendHeartbeat();
        lastHeartbeat = millis();
      }
      if (cardsDue || millis() - lastCardSync > CARD_SYNC_MS) {
        syncCards();
        lastCardSync = millis();
        cardsDue = false;
      }
    }
    vTaskDelay(pdMS_TO_TICKS(pendingN ? 50 : 200));
  }
}


bool timeIsValid() { return time(nullptr) > 1700000000; }

void formatLocalTime(char* out, size_t n) {
  time_t t = time(nullptr) + TZ_OFFSET_SEC;
  struct tm tmv;
  gmtime_r(&t, &tmv);
  snprintf(out, n, "%02d:%02d:%02d", tmv.tm_hour, tmv.tm_min, tmv.tm_sec);
}

void eventsBegin() {
  s_bootId = esp_random();
  s_queue = xQueueCreate(QUEUE_LEN, sizeof(SafeEvent));
  // Core 0 cho mạng, loop() Arduino chạy ở core 1.
  xTaskCreatePinnedToCore(netTask, "net", 12288, nullptr, 1, nullptr, 0);
}

void setReportedState(const char* state) { s_state = state; }

void logEvent(const char* type, const char* message, const char* metaJson) {
  char hhmmss[10];
  formatLocalTime(hhmmss, sizeof hhmmss);
  Serial.printf("[LOG] Time: %s - Sự kiện: %s (%s)%s%s\n", hhmmss, message, type,
                metaJson ? " " : "", metaJson ? metaJson : "");

  SafeEvent ev = {};
  portENTER_CRITICAL(&s_seqMux);
  ev.seq = ++s_seq;
  portEXIT_CRITICAL(&s_seqMux);
  ev.ts = timeIsValid() ? (uint32_t)time(nullptr) : 0;
  strlcpy(ev.type, type, sizeof ev.type);
  strlcpy(ev.state, (const char*)s_state, sizeof ev.state);
  strlcpy(ev.message, message, sizeof ev.message);
  if (metaJson) strlcpy(ev.meta, metaJson, sizeof ev.meta);

  if (xQueueSend(s_queue, &ev, 0) != pdTRUE) {
    // Hàng đợi đầy (mất mạng lâu): bỏ sự kiện cũ nhất, giữ sự kiện mới.
    SafeEvent dropped;
    xQueueReceive(s_queue, &dropped, 0);
    xQueueSend(s_queue, &ev, 0);
  }
}

// ============================================================================
//  8. CHƯƠNG TRÌNH CHÍNH
// ============================================================================
// ------------------------------------------------------------- Phần cứng ----
MFRC522 rfid(PIN_RFID_SS, PIN_RFID_RST);
LiquidCrystal_I2C lcd(LCD_I2C_ADDR, 16, 2);
RTC_DS3231 rtc;
Servo lockServo;
Preferences prefs;

const byte KP_ROWS = 4, KP_COLS = 4;
char kpKeys[KP_ROWS][KP_COLS] = {
  {'1', '2', '3', 'A'},
  {'4', '5', '6', 'B'},
  {'7', '8', '9', 'C'},
  {'*', '0', '#', 'D'},
};
byte kpRowPins[KP_ROWS] = KP_ROWS_PINS;
byte kpColPins[KP_COLS] = KP_COLS_PINS;
Keypad keypad(makeKeymap(kpKeys), kpRowPins, kpColPins, KP_ROWS, KP_COLS);

// ------------------------------------------------------------ Trạng thái ----

State state = STATE_LOCKED;
uint32_t stateSince = 0;
char otpInput[7] = "";
uint8_t otpLen = 0;
uint8_t failCount = 0;          // lưu NVS: rút điện không reset được
const char* alarmReason = "";

uint8_t totpKey[64];
int totpKeyLen = 0;
TotpVerifier* verifier = nullptr;

bool rtcOk = false;
volatile bool rtcNeedsWrite = false;

uint32_t servoDetachAt = 0, lastCardPoll = 0;
uint32_t calibUntil = 0, msgUntil = 0, lastVibrationEvent = 0;
char msgText[17] = "";
char lcdCache[2][17] = {"", ""};

// --------------------------------------------------------------- Tiện ích ----
void lcdLine(uint8_t row, const char* fmt, ...) {
  char buf[33];
  va_list ap;
  va_start(ap, fmt);
  vsnprintf(buf, sizeof buf, fmt, ap);
  va_end(ap);
  char line[17];
  snprintf(line, sizeof line, "%-16.16s", buf);
  if (strcmp(line, lcdCache[row]) == 0) return;   // tránh nhấp nháy
  strcpy(lcdCache[row], line);
  lcd.setCursor(0, row);
  lcd.print(line);
}

// Hiện một thông báo ngắn ở dòng 2 của LCD trong `ms` mili giây.
void flash(const char* text, uint32_t ms) {
  strlcpy(msgText, text, sizeof msgText);
  msgUntil = millis() + ms;
}

void moveServo(int angle) {
  if (!lockServo.attached()) lockServo.attach(PIN_SERVO, 500, 2400);
  lockServo.write(angle);
  servoDetachAt = millis() + 700;   // nhả servo để không rung/ồn
  tamperMute(SERVO_MUTE_MS);        // servo + đóng cửa làm vỏ két rung
}

void saveSecurityState(bool alarm) {
  prefs.putBool("alarm", alarm);
  prefs.putUChar("fails", failCount);
}

void enterState(State s) {
  State prev = state;
  state = s;
  stateSince = millis();
  otpLen = 0;
  otpInput[0] = '\0';
  setReportedState(STATE_NAMES[s]);
  lcd.backlight();

  switch (s) {
    case STATE_LOCKED:
      if (prev == STATE_OPEN) moveServo(SERVO_LOCK_ANGLE);
      tamperArm(true);
      break;
    case STATE_WAIT_OTP:
      tamperArm(true);
      break;
    case STATE_OPEN:
      moveServo(SERVO_OPEN_ANGLE);
      tamperArm(false);   // đang lấy đồ, đụng chạm là bình thường
      break;
    case STATE_ALARM:
      tamperArm(false);
      break;
  }
}

void triggerAlarm(const char* reason, const char* metaJson) {
  alarmReason = reason;
  enterState(STATE_ALARM);
  saveSecurityState(true);
  logEvent("ALARM", strcmp(reason, "TAMPER") == 0 ? "BÁO ĐỘNG: phát hiện cạy phá"
                    : strcmp(reason, "OTP_FAILS") == 0 ? "BÁO ĐỘNG: nhập sai OTP quá số lần"
                    : "BÁO ĐỘNG: khởi động lại khi đang báo động",
           metaJson);
}

bool readCard(char* uid, size_t n) {
  if (!rfid.PICC_IsNewCardPresent() || !rfid.PICC_ReadCardSerial()) return false;
  size_t pos = 0;
  uid[0] = '\0';
  for (byte i = 0; i < rfid.uid.size && pos + 3 < n; i++)
    pos += snprintf(uid + pos, n - pos, i ? " %02X" : "%02X", rfid.uid.uidByte[i]);
  rfid.PICC_HaltA();
  rfid.PCD_StopCrypto1();
  return true;
}

void onTimeSync(struct timeval*) { rtcNeedsWrite = true; }   // chạy ở task SNTP

void setSystemTime(uint32_t unixUtc) {
  struct timeval tv = {(time_t)unixUtc, 0};
  settimeofday(&tv, nullptr);
}

// Lệnh qua Serial Monitor (115200, kết thúc dòng "LF"):
//   time              – xem giờ hệ thống
//   settime <unix>    – đặt giờ thủ công khi không có WiFi (unix UTC, vd: date +%s)
//   otp               – in mã OTP hiện tại (chỉ khi DEBUG_PRINT_OTP = true)
//   reset             – xóa trạng thái báo động + số lần sai (khi test)
void handleSerial() {
  static char buf[40];
  static uint8_t len = 0;
  while (Serial.available()) {
    char c = Serial.read();
    if (c == '\r') continue;
    if (c != '\n') { if (len < sizeof buf - 1) buf[len++] = c; continue; }
    buf[len] = '\0';
    len = 0;
    char hhmmss[10];
    if (strcmp(buf, "time") == 0) {
      formatLocalTime(hhmmss, sizeof hhmmss);
      Serial.printf("[TIME] unix=%ld local=%s time_ok=%d rtc=%d\n", (long)time(nullptr),
                    hhmmss, timeIsValid(), rtcOk);
    } else if (strncmp(buf, "settime ", 8) == 0) {
      uint32_t t = strtoul(buf + 8, nullptr, 10);
      if (t > 1700000000) {
        setSystemTime(t);
        rtcNeedsWrite = true;
        Serial.println(F("[TIME] Da dat gio"));
      }
    } else if (strcmp(buf, "otp") == 0 && DEBUG_PRINT_OTP && verifier) {
      Serial.printf("[DEBUG] OTP hien tai: %06u\n", verifier->current(time(nullptr)));
    } else if (strcmp(buf, "cards") == 0) {
      printCards();
    } else if (strcmp(buf, "reset") == 0) {
      failCount = 0;
      saveSecurityState(false);
      enterState(STATE_LOCKED);
      Serial.println(F("[DEBUG] Da xoa trang thai bao dong"));
    }
  }
}

// ------------------------------------------------------------------ setup ----
void setup() {
  Serial.begin(115200);
  delay(200);
  Serial.println(F("\n=== KET SAT THONG MINH – ESP32 ==="));

  Wire.begin(PIN_I2C_SDA, PIN_I2C_SCL);
  lcd.init();
  lcd.backlight();
  lcdLine(0, "KET SAT IoT");
  lcdLine(1, "Dang khoi dong..");

  lockServo.setPeriodHertz(50);
  moveServo(SERVO_LOCK_ANGLE);

  SPI.begin(PIN_RFID_SCK, PIN_RFID_MISO, PIN_RFID_MOSI, PIN_RFID_SS);
  rfid.PCD_Init();
  byte ver = rfid.PCD_ReadRegister(MFRC522::VersionReg);
  if (ver == 0x00 || ver == 0xFF)
    Serial.println(F("[LOI] Khong thay RC522 – kiem tra day SPI va nguon 3.3V"));

  // Giờ: RTC giữ giờ khi mất điện, NTP hiệu chỉnh lại khi có WiFi.
  rtcOk = rtc.begin(&Wire);
  if (!rtcOk) Serial.println(F("[LOI] Khong thay DS3231 – kiem tra day I2C"));
  if (rtcOk && !rtc.lostPower()) setSystemTime(rtc.now().unixtime());   // RTC lưu giờ UTC
  WiFi.mode(WIFI_STA);   // khởi tạo network stack trước khi gọi SNTP
  sntp_set_time_sync_notification_cb(onTimeSync);
  configTime(0, 0, "pool.ntp.org", "time.google.com");

  totpKeyLen = base32Decode(TOTP_SECRET_B32, totpKey, sizeof totpKey);
  if (totpKeyLen < 10) {
    Serial.println(F("[LOI] TOTP_SECRET_B32 khong hop le (can >= 16 ky tu Base32)"));
    lcdLine(0, "LOI TOTP SECRET");
    lcdLine(1, "Kiem tra config");
    while (true) delay(1000);
  }
  verifier = new TotpVerifier(totpKey, totpKeyLen);

  TamperConfig tc = {PIN_VIB_DO, VIB_ACTIVE_HIGH, TAMPER_WINDOW_MS, TAMPER_HITS,
                     TAMPER_VIB_MS, HIT_GAP_MS};
  tamperBegin(tc);
  delay(300);
  if ((digitalRead(PIN_VIB_DO) == HIGH) == VIB_ACTIVE_HIGH)
    Serial.println(F("[CANH BAO] SW-420 dang bao 'rung' khi dung yen: doi VIB_ACTIVE_HIGH "
                     "hoac van bien tro giam do nhay"));

  prefs.begin("ketsat", false);
  failCount = prefs.getUChar("fails", 0);

  cardsBegin();
  if (!REQUIRE_CARD) Serial.println(F("[TEST] REQUIRE_CARD=false: bam phim A de nhap OTP, khong can the"));
  if (!TAMPER_ENABLED) Serial.println(F("[TEST] TAMPER_ENABLED=false: cam bien rung KHONG gay bao dong"));

  eventsBegin();
  char meta[96];
  snprintf(meta, sizeof meta, "{\"fw\":\"%s\",\"rtc\":%s,\"time_ok\":%s}", FW_VERSION,
           rtcOk ? "true" : "false", timeIsValid() ? "true" : "false");

  enterState(STATE_LOCKED);
  logEvent("BOOT", "Khởi động hệ thống", meta);

  // Bị rút điện giữa lúc báo động -> vẫn tiếp tục báo động.
  if (prefs.getBool("alarm", false)) triggerAlarm("REBOOT", "{\"reason\":\"REBOOT\"}");
}

// ------------------------------------------------------------------- loop ----
void loop() {
  uint32_t now = millis();
  handleSerial();

  if (rtcNeedsWrite && rtcOk) {
    rtcNeedsWrite = false;
    rtc.adjust(DateTime((uint32_t)time(nullptr)));
    Serial.println(F("[TIME] Da dong bo gio -> RTC"));
  }

  if (servoDetachAt && (int32_t)(now - servoDetachAt) >= 0) {
    lockServo.detach();
    servoDetachAt = 0;
  }

  // Báo động: nháy đèn nền LCD để dễ thấy từ xa (thay cho còi/LED).
  if (state == STATE_ALARM) {
    static bool lastOn = true;
    bool on = (now / 500) % 2;
    if (on != lastOn) { on ? lcd.backlight() : lcd.noBacklight(); lastOn = on; }
  }

  char key = keypad.getKey();
  if (key) tamperMute(KEY_MUTE_MS);   // bấm phím trên cửa làm vỏ két rung

  char uid[32];
  bool card = false;
  if (now - lastCardPoll >= 100) {
    lastCardPoll = now;
    card = readCard(uid, sizeof uid);
    if (card) Serial.printf("[RFID] UID: %s\n", uid);
  }

  // ---- Cảm biến rung ----
  TamperWindow w;
  bool tamper = tamperPoll(&w);
  bool armed = state == STATE_LOCKED || state == STATE_WAIT_OTP;
  if (w.hits > 0 || w.vibMs > 0)
    Serial.printf("[SENSOR] %u va dap, rung %u ms / %u ms\n", w.hits, w.vibMs, TAMPER_WINDOW_MS);
  if (tamper && armed && !TAMPER_ENABLED) {
    Serial.println(F("[TEST] Vuot nguong rung nhung TAMPER_ENABLED=false -> bo qua"));
  } else if (tamper && armed) {
    char meta[80];
    snprintf(meta, sizeof meta, "{\"reason\":\"TAMPER\",\"hits\":%u,\"vibration_ms\":%u}",
             w.hits, w.vibMs);
    triggerAlarm("TAMPER", meta);
  } else if ((w.hits > 0 || w.vibMs > 0) && armed && now - lastVibrationEvent > 10000) {
    // Rung nhẹ dưới ngưỡng: ghi lại để thấy bộ lọc hoạt động (tối đa 1 lần / 10 s).
    lastVibrationEvent = now;
    char meta[80];
    snprintf(meta, sizeof meta, "{\"hits\":%u,\"vibration_ms\":%u}", w.hits, w.vibMs);
    logEvent("VIBRATION", "Rung nhẹ dưới ngưỡng – bỏ qua", meta);
  }

  // ---- Máy trạng thái ----
  switch (state) {
    case STATE_LOCKED:
      if (card) {
        char meta[48];
        snprintf(meta, sizeof meta, "{\"uid\":\"%s\"}", uid);
        if (isAdminCard(uid)) {
          enterState(STATE_WAIT_OTP);
          logEvent("CARD_ADMIN", "Quẹt thẻ Admin hợp lệ", meta);
        } else {
          flash("The khong hop le", 2000);
          logEvent("CARD_UNKNOWN", "Quẹt thẻ lạ", meta);
        }
      }
      if (key == 'D') calibUntil = now + 20000;   // màn hình hiệu chỉnh cảm biến
      if (!REQUIRE_CARD && key == 'A') {
        Serial.println(F("[TEST] Vao nhap OTP khong can the"));
        enterState(STATE_WAIT_OTP);
      }
      break;

    case STATE_WAIT_OTP: {
      bool submit = false;
      if (key >= '0' && key <= '9' && otpLen < 6) {
        otpInput[otpLen++] = key;
        otpInput[otpLen] = '\0';
        if (otpLen == 6) submit = true;
      } else if (key == '*' && otpLen > 0) {
        otpInput[--otpLen] = '\0';
      } else if (key == '#' && otpLen > 0) {
        submit = true;
      } else if (key == 'C') {
        enterState(STATE_LOCKED);
        flash("Da huy", 1500);
        break;
      }

      if (submit) {
        bool ok = timeIsValid() && verifier->verify(otpInput, time(nullptr));
        if (ok) {
          failCount = 0;
          saveSecurityState(false);
          enterState(STATE_OPEN);
          logEvent("OPENED", "Mở két (thẻ + OTP)", nullptr);
        } else {
          failCount++;
          saveSecurityState(false);
          char meta[64];
          snprintf(meta, sizeof meta, "{\"attempt\":%u,\"max\":%u,\"time_ok\":%s}", failCount,
                   MAX_OTP_FAILS, timeIsValid() ? "true" : "false");
          logEvent("OTP_WRONG", "Nhập sai OTP", meta);
          if (failCount >= MAX_OTP_FAILS) {
            char m[48];
            snprintf(m, sizeof m, "{\"reason\":\"OTP_FAILS\",\"attempts\":%u}", failCount);
            triggerAlarm("OTP_FAILS", m);
            break;
          }
          char t[17];
          if (timeIsValid()) snprintf(t, sizeof t, "Sai ma (%u/%u)", failCount, MAX_OTP_FAILS);
          else strlcpy(t, "Loi dong ho!", sizeof t);
          flash(t, 1500);
          otpLen = 0;
          otpInput[0] = '\0';
        }
      } else if (now - stateSince > OTP_INPUT_MS) {
        enterState(STATE_LOCKED);
        logEvent("OTP_TIMEOUT", "Hết thời gian nhập OTP", nullptr);
        flash("Het thoi gian", 2000);
      }
      break;
    }

    case STATE_OPEN:
      if (key == '#') {
        enterState(STATE_LOCKED);
        logEvent("LOCKED", "Khóa két", "{\"by\":\"keypad\"}");
      } else if (now - stateSince > AUTO_LOCK_MS) {
        enterState(STATE_LOCKED);
        logEvent("LOCKED", "Tự động khóa két", "{\"by\":\"auto\"}");
      }
      break;

    case STATE_ALARM:
      if ((card && isAdminCard(uid)) || (!REQUIRE_CARD && key == 'A')) {
        failCount = 0;
        saveSecurityState(false);
        enterState(STATE_LOCKED);
        tamperMute(3000);
        char meta[48];
        if (card) snprintf(meta, sizeof meta, "{\"uid\":\"%s\"}", uid);
        else strlcpy(meta, "{\"by\":\"test_key\"}", sizeof meta);
        logEvent("ALARM_RESET", "Admin tắt báo động", meta);
      }
      break;
  }

  // ---- LCD ----
  char hhmmss[10];
  formatLocalTime(hhmmss, sizeof hhmmss);
  bool showMsg = (int32_t)(msgUntil - now) > 0;
  switch (state) {
    case STATE_LOCKED:
      lcdLine(0, "KET SAT %s", timeIsValid() ? hhmmss : "--:--:--");
      if (showMsg) {
        lcdLine(1, "%s", msgText);
      } else if ((int32_t)(calibUntil - now) > 0) {
        TamperWindow live = tamperLive(), last = tamperLast();
        lcdLine(1, "N%u %ums T:%u/%u", live.hits, live.vibMs, last.hits, last.vibMs);
      } else if (!timeIsValid()) {
        lcdLine(1, "CHUA CO GIO!");
      } else {
        lcdLine(1, REQUIRE_CARD ? "Quet the Admin.." : "A=Nhap OTP(TEST)");
      }
      break;
    case STATE_WAIT_OTP: {
      uint32_t left = (OTP_INPUT_MS - min<uint32_t>(now - stateSince, OTP_INPUT_MS)) / 1000;
      lcdLine(0, "Nhap OTP:    %2us", left);
      if (showMsg) lcdLine(1, "%s", msgText);
      else lcdLine(1, "> %-6.*s   #=OK", otpLen, "******");
      break;
    }
    case STATE_OPEN: {
      uint32_t left = (AUTO_LOCK_MS - min<uint32_t>(now - stateSince, AUTO_LOCK_MS)) / 1000;
      lcdLine(0, "KET DANG MO");
      lcdLine(1, "#=Khoa  Tu %3us", left);
      break;
    }
    case STATE_ALARM:
      lcdLine(0, "!! BAO DONG !!");
      if ((now / 2000) % 2) {
        lcdLine(1, REQUIRE_CARD ? "Quet the Admin" : "A=Tat (TEST)");
      } else if (strcmp(alarmReason, "TAMPER") == 0) {
        lcdLine(1, "CANH BAO PHA KET");
      } else if (strcmp(alarmReason, "OTP_FAILS") == 0) {
        lcdLine(1, "Sai OTP %u lan", MAX_OTP_FAILS);
      } else {
        lcdLine(1, "Mat dien luc BD");
      }
      break;
  }

#if ENABLE_PLOTTER
  // Serial Plotter: số liệu rung của cửa sổ đang chạy, mỗi 50 ms.
  static uint32_t lastPlot = 0;
  if (now - lastPlot >= 50) {
    TamperWindow live = tamperLive();
    Serial.printf("rung_ms:%u,va_dap:%u\n", live.vibMs, live.hits);
    lastPlot = now;
  }
#endif
}
