// ============================================================================
//  3. KIỂU DỮ LIỆU DÙNG CHUNG
// ============================================================================
// TOTP theo RFC 6238 (HMAC-SHA1, bước 30 giây, 6 chữ số) – tương thích
// Google Authenticator / Microsoft Authenticator.
// Viết thuần C++, không phụ thuộc thư viện ngoài.

// Giải mã chuỗi Base32 (RFC 4648, bỏ qua khoảng trắng, dấu '-' và '=').
// Trả về số byte đã ghi vào out, hoặc -1 nếu chuỗi không hợp lệ / quá dài.
int base32Decode(const char* in, uint8_t* out, size_t outMax);

// HMAC-SHA1 (RFC 2104). out phải có 20 byte.
void hmacSha1(const uint8_t* key, size_t keyLen,
              const uint8_t* msg, size_t msgLen, uint8_t out[20]);

// HOTP (RFC 4226): trả về mã dạng số nguyên, digits thường là 6.
uint32_t hotp(const uint8_t* key, size_t keyLen, uint64_t counter, int digits);

// Bộ kiểm tra TOTP có dung sai ±window bước và chống dùng lại mã (anti-replay).
class TotpVerifier {
 public:
  TotpVerifier(const uint8_t* key, size_t keyLen, uint32_t period = 30,
               int digits = 6, int window = 1)
      : key_(key), keyLen_(keyLen), period_(period), digits_(digits),
        window_(window) {}

  // code: chuỗi số người dùng nhập. unixUtc: thời gian hiện tại (giây, UTC).
  // Trả về true nếu hợp lệ; khi đó bước thời gian được đánh dấu "đã dùng".
  bool verify(const char* code, uint64_t unixUtc);

  // Mã hiện tại (dùng để debug qua Serial – KHÔNG in ra LCD).
  uint32_t current(uint64_t unixUtc) const {
    return hotp(key_, keyLen_, unixUtc / period_, digits_);
  }

 private:
  const uint8_t* key_;
  size_t keyLen_;
  uint32_t period_;
  int digits_;
  int window_;
  int64_t lastUsedStep_ = -1;
};

// Phát hiện cạy phá bằng SW-420: đo trong mỗi cửa sổ thời gian
//   - số lần va đập (các xung sát nhau được gộp lại)
//   - tổng thời gian DO ở mức "đang rung"

struct TamperWindow {
  uint16_t hits;      // số lần va đập
  uint16_t vibMs;     // tổng thời gian rung (ms)
};

